
generateSecretKey
{
	void FUNCTIONEX('internal_crypto', 'GenerateKeyPair', 'bip340')
	valueex[0]
}

getPublicKey
{
	_privateKey = _argv[0]
	FUNCTIONEX('internal_crypto', 'KeyAgreement', 'secp256k1', _privateKey, '79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798')
}

finalizeEvent
{
	_ev = _argv[0]
	_secretKey = _argv[1]

	_ev['pubkey'] = getPublicKey(_secretKey)
	_ev['id'] = getEventHash(_ev)
	_ev['sig'] = FUNCTIONEX('internal_crypto', 'Sign', 'bip340', _secretKey, _ev['id'], '--data-in=hex')
	_ev
}

verifyEvent
{
	_ev = _argv[0]

	if _ev['id'] != getEventHash(_ev) {
		return 0
	}

	FUNCTIONEX('internal_crypto', 'Verify', 'bip340', _ev['pubkey'], _ev['id'], _ev['sig'], '--data-in=hex')
}

serializeEvent
{
	_ev = _argv[0]
	_json = '[0,'
	_json += DUMPJSON(_ev['pubkey']) + ','
	_json += DUMPJSON(_ev['created_at']) + ','
	_json += DUMPJSON(_ev['kind']) + ','
	_json += DUMPJSON(_ev['tags']) + ','
	_json += DUMPJSON(_ev['content']) + ']'
	_json
}

getEventHash
{
	_ev = _argv[0]
	FUNCTIONEX('internal_crypto', 'Digest', 'sha256', serializeEvent(_ev))
}

makeZapRequest
{
	_targetPubkey = _argv[0]
	_zapAmount = _argv[1]
	_zapMessage = _argv[2]
	_relays = _argv[3, -1]

	_t = GETTIME()
	_now = GETSECCOUNT(_t[0], _t[1], _t[2], 0, _t[4], _t[5], _t[6])
	_tags = PARSEJSON('[[1,2],[3,4],[5,6]]')
	_tags[0] = ('p', _targetPubkey)
	_tags[1] = ('amount', TOSTR(_zapAmount))
	_tags[2] = ('relays', _relays)

	_event = IHASH()
	_event['kind'] = 9734
	_event['created_at'] = _now
	_event['content'] = _zapMessage
	_event['tags'] = _tags

	_event
}
